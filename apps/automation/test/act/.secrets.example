# Copy this file to .secrets (gitignored) and fill in your values.
# act reads this file automatically when running from the repo root.
#
# GITHUB_TOKEN is the minimum required — act uses it for the github LLM
# fallback and for any GitHub API calls in dry-run mode.
# Get it with: gh auth token

GITHUB_TOKEN=your_github_token_here

# Optional — only needed if you want to test with a specific LLM provider
# rather than relying on the github fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional — needed for Slack notification steps
SLACK_WEBHOOK=
SLACK_BOT_TOKEN=
